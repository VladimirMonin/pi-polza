{
  "name": "pi-polza",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Polza AI as a native dynamic model provider for Pi Agent: auto-loaded catalog, capabilities, OpenRouter enrichment and actual RUB billing.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-agent",
    "polza",
    "polza-ai",
    "provider",
    "extension",
    "llm",
    "rub"
  ],
  "license": "MIT",
  "homepage": "https://github.com/VladimirMonin/pi-polza#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VladimirMonin/pi-polza.git"
  },
  "bugs": {
    "url": "https://github.com/VladimirMonin/pi-polza/issues"
  },
  "files": [
    ".pi/extensions/pi-polza",
    "docs/images",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./.pi/extensions/pi-polza"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "probe:catalog": "node scripts/probe-catalog.ts",
    "probe:balance": "node scripts/probe-balance.ts",
    "probe:chat": "node scripts/probe-chat.ts",
    "probe:stream": "node scripts/probe-stream.ts",
    "probe:cache": "node scripts/probe-cache.ts",
    "probe:openrouter": "node scripts/probe-openrouter.ts",
    "probe:enrichment": "node scripts/probe-enrichment.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "probe:ttft": "node scripts/probe-ttft.ts",
    "probe:persistence": "node scripts/verify-persistence.ts",
    "probe:startup": "node scripts/probe-startup.ts",
    "probe:reasoning": "node scripts/probe-reasoning.ts",
    "probe:conflicts": "node scripts/probe-conflicts.ts",
    "probe:orphans": "node scripts/probe-orphans.ts",
    "test:live": "node --test \"tests-live/**/*.test.ts\"",
    "audit:secrets": "node scripts/audit-secrets.ts"
  }
}
